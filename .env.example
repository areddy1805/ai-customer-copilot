# -------- APP --------
APP_ENV=local

# -------- PROVIDER SWITCHES --------
LLM_PROVIDER=local            # local | azure
EMBEDDING_PROVIDER=local      # local | azure
SEARCH_PROVIDER=local         # local | azure
SECRET_PROVIDER=env           # env | keyvault

# -------- LOCAL (OLLAMA) --------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=60

# -------- AZURE OPENAI --------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# -------- AZURE EMBEDDINGS --------
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_API_VERSION=2024-12-01-preview

# -------- AZURE AI SEARCH --------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=

# -------- AZURE KEY VAULT --------
AZURE_KEY_VAULT_URL=

# -------- CACHE / MEMORY --------
REDIS_HOST=localhost
REDIS_PORT=6379

# -------- DATABASE (OPTIONAL / FUTURE) --------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=copilot
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# -------- FEATURES --------
AGENT_ENABLED=true